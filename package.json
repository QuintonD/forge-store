{
  "name": "forge-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/gen-demos.mjs",
    "gen:demos": "node scripts/gen-demos.mjs",
    "attest": "npm run gen:demos && node scripts/attest.mjs",
    "verify": "node scripts/verify.mjs",
    "validate": "node scripts/validate.mjs",
    "prebuild": "npm run attest && npm run validate",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/verify.mjs && node scripts/validate.mjs --with-dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "lucide-react": "^1.33.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.0"
  }
}
